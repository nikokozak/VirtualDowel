'Virtual Dowel example side-B job - for the half-slot dry run in the README (H1) only
'SHOPBOT ROUTER FILE IN INCHES
'GENERATED BY VCarve Pro
'Minimum extent in X = 0.000 Minimum extent in Y = 0.000 Minimum extent in Z = -0.760
'Maximum extent in X = 24.000 Maximum extent in Y = 30.000 Maximum extent in Z = 0.200
'Length of material in X = 24.000
'Length of material in Y = 30.000
'Depth of material in Z = 0.750
'Home Position Information = Bottom Left Corner, Material Surface
'Home X = 0.000000 Home Y = 0.000000 Home Z = 0.200000
'Rapid clearance gap or Safe Z = 0.200
'UNITS:Inches
'
IF %(25)=1 THEN GOTO UNIT_ERROR	'check to see software is set to standard
SA                             	'Set program to absolute coordinate mode
CN, 90
'New Path
'Toolpath Name = Pocket 1
'Tool Name   = End Mill (0.25 inch)
&PWSafeZ = 0.200
&PWZorigin = Material Surface
&PWMaterial = 0.750
'&ToolName = "End Mill (0.25 inch)"
&Tool = 1                      	'Jog Z axis to safe height
C9
TR,18000
C6                             	'Return tool to home in x and y
PAUSE 2
'
MS,2.0,0.5
JZ,0.200000
J2,0.000000,0.000000
J3,5.000000,5.000000,0.200000
M3,5.000000,5.000000,-0.250000
M3,10.000000,5.000000,-0.250000
M3,10.000000,8.000000,-0.250000
CG, ,11.000000,9.000000,1.000000,0.000000,T,-1
M3,15.000000,9.000000,-0.250000
CG, ,17.000000,11.000000,0.000000,2.000000,T,1
M3, ,14.000000,-0.250000
M3,5.000000, ,-0.250000
MX,4.000000
MY,6.000000
M2 4.5, 6.5
m3,4.75,6.75,&PWMaterial * -0.5
JZ,&PWSafeZ
'Full circle, then two more laps inheriting I/J
J3,12.000000,20.000000,0.200000
MZ,-0.300000
CG, , , ,1.500000,0.000000,T,1
CG, , , , , ,T,1,-0.1,2
JZ,0.200000
'Diameter-mode arc
J2,3.000000,25.000000
MZ,-0.100000
CG,4.000000,6.000000,25.000000, , ,T,1
CG,4.000000,3.000000,25.000000, , ,T,-1
JZ,0.200000
'Relative section
SR
M2,1.000000,0.500000
M3,0.000000,1.000000,0.000000
JX,-2.000000
M3, ,0.25,
SA
J2,20,25
J4,21,26,0.2,15
JZ,0.200000
J2,0.000000,0.000000
'
'Turning router OFF
C7
END
'
UNIT_ERROR:
C#,91                          'Run file explaining unit error
END
